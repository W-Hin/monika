# Claude Code / AI tooling — never committed, regardless of personal global
# git config. Notes, plans, and review artifacts generated by Claude Code
# or its skills (superpowers, graphify, etc.) are local working files only.
.claude/
.superpowers/
docs/superpowers/
graphify-out/
CLAUDE.local.md

# Miscellaneous

# ML training data — regenerate with ml/generate_synthetic.py (seeded)
ml/data/

# Backend secrets — commit backend/config.example.php, never backend/config.php
backend/config.php

# Supabase config — commit supabase_config.example.dart, never supabase_config.dart
lib/core/config/supabase_config.dart

# Backend PHP dependencies — commit composer.json/composer.lock, not these
backend/vendor/
backend/composer.phar

# Dev-mode password reset token log (stand-in until real email is wired up)
backend/storage/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
